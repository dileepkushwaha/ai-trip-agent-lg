# ============================================
# AI Trip Agent - Environment Configuration
# ============================================

# Application Settings
APP_NAME=AI Trip Agent
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_RELOAD=true

# ============================================
# LLM Provider Configuration
# ============================================
# Options: lmstudio, openai, anthropic, azure, ollama
LLM_PROVIDER=lmstudio

# LLM Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# ============================================
# LM Studio (Local LLM) - Default
# ============================================
LMSTUDIO_API_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=llama-3.2-1b-instruct

# ============================================
# OpenAI Configuration
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_API_BASE=  # Optional: for proxies or custom endpoints

# ============================================
# Anthropic (Claude) Configuration
# ============================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================
# Azure OpenAI Configuration
# ============================================
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# ============================================
# Ollama (Local Alternative)
# ============================================
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ============================================
# Abacus AI Configuration
# ============================================
# Get your API key from: https://abacus.ai/
ABACUSAI_API_KEY=
ABACUSAI_MODEL=gpt-5
ABACUSAI_API_URL=
# ============================================
# Embeddings Configuration
# ============================================
# Options: openai, huggingface
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ============================================
# ChromaDB Configuration
# ============================================
CHROMA_HOST=localhost
CHROMA_PORT=8002
CHROMA_COLLECTION_NAME=assam_travel_knowledge
CHROMA_PERSIST_DIRECTORY=./_chroma

# ============================================
# RAG Configuration
# ============================================
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# ============================================
# LangSmith (Experiment Tracking)
# ============================================
# Get your API key from: https://smith.langchain.com/
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=ai-trip-agent
LANGSMITH_TRACING=true

# ============================================
# Carbon Calculation
# ============================================
CARBON_API_ENABLED=true
CARBON_DEFAULT_EMISSION_FACTOR=0.12

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================
# Security Configuration
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8516,http://localhost:3000
API_KEY_HEADER=X-API-Key
# API_KEY=  # Optional: for API authentication

# ============================================
# Cloud Deployment (Optional)
# ============================================
# CLOUD_PROVIDER=aws  # Options: aws, gcp, azure
# STATIC_IP=  # Your static IP address
# DOMAIN_NAME=  # Your domain name
